rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cascadia フレコン在庫管理コレクション
    match /cascadia_flexcon/{docId} {
      allow read, write: if true;
    }
    // Cascadia 南関工場生産進捗コレクション
    match /cascadia_nankan/{docId} {
      allow read, write: if true;
    }
  }
}
